{
  "id": "oc.m3.d1.ocVE.Apolytikion",
  "kind": "hymn",
  "title_gr": "Εὐφραινέσθω τὰ οὐράνια",
  "title_en": "Let the heavens rejoice",
  "stage": 1,
  "melodic_speed": "heirmologic",
  "transliteration": null,
